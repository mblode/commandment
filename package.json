{
  "name": "commandment",
  "packageManager": "npm@11.18.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev --filter=commandment-web",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "macos:build": "turbo run build --filter=@commandment/macos",
    "macos:test": "turbo run test --filter=@commandment/macos",
    "test": "turbo run test",
    "web:build": "turbo run build --filter=commandment-web",
    "web:dev": "turbo run dev --filter=commandment-web"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  }
}
